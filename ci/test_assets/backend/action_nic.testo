
include "common.testo"

[snapshots: "never"]
test unplug_plug_nic {
	my_ubuntu_server {
		unplug nic nat
		unplug nic internal
		plug nic bridge
		plug nic nat
		start
		abort "stop here"
	}
}

[snapshots: "never"]
test rollback_after_unplug_plug_nic {
	my_ubuntu_server {
		start
		abort "stop here"
	}
}

[snapshots: "never"]
test unplug_plug_link {
	my_ubuntu_server {
		unplug link nat
		unplug link internal
		plug link nat
		start
		abort "stop here"
	}
}

[snapshots: "never"]
test rollback_after_unplug_plug_link {
	my_ubuntu_server {
		start
		abort "stop here"
	}
}
