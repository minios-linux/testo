
include "../common/definitions.testo"

[snapshots: "never"]
test sleep_not_defined {
	my_ubuntu_server {
		sleep "${not_defined}"
	}
}

[snapshots: "never"]
test print_not_defined {
	my_ubuntu_server {
		print "${not_defined}"
	}
}

[snapshots: "never"]
test abort_not_defined {
	my_ubuntu_server {
		abort "${not_defined}"
	}
}

[snapshots: "never"]
test type_not_defined {
	my_ubuntu_server {
		type "${not_defined}"
	}
}

[snapshots: "never"]
test wait_not_defined {
	my_ubuntu_server {
		wait "${not_defined}"
	}
}

[snapshots: "never"]
test mouse_text_not_defined {
	my_ubuntu_server {
		mouse move "${not_defined}"
	}
}

[snapshots: "never"]
test mouse_js_not_defined {
	my_ubuntu_server {
		mouse move js "${not_defined}"
	}
}

flash my_flash {
	size: 16Mb
	fs: "fat"
}

macro plug_flash(name) {
	plug flash "${name}"
}

[snapshots: "never"]
test flash_not_defined {
	my_ubuntu_server {
		plug_flash("my_flash")
		plug_flash("undefined_flash")
	}
}

[snapshots: "never"]
test dvd_not_defined {
	my_ubuntu_server {
		plug dvd "${not_defined}"
	}
}

[snapshots: "never"]
test from_not_defined {
	my_ubuntu_server {
		copyto "${not_defined}" "lala"
	}
}

[snapshots: "never"]
test to_not_defined {
	my_ubuntu_server {
		copyfrom "lala" "${not_defined}"
	}
}

[snapshots: "never"]
test exec_not_defined {
	my_ubuntu_server {
		exec bash "${not_defined}"
	}
}

macro my_macro(arg, default="${default_not_defined}") {
}

[snapshots: "never"]
test macro_arg_not_defined {
	my_ubuntu_server {
		my_macro("${arg_not_defined}")
	}
}

[snapshots: "never"]
test macro_default_arg_not_defined {
	my_ubuntu_server {
		my_macro("1")
	}
}

[snapshots: "never"]
test factor_not_defined {
	my_ubuntu_server {
		if ("${factor_not_defined}") {

		}
	}
}

machine my_machine {
	iso: {
		source: "${iso_not_defined}"
	}
}

[snapshots: "never"]
test attr_not_defined {
	my_machine {

	}
}
